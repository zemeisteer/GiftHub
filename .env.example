# ==============================================================================
# GiftHub — Environment Configuration Template
# ==============================================================================

# --- Telegram Bot Configuration ---
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMINS=YOUR_TELEGRAM_ADMIN_ID
IP=127.0.0.1
PORT=8000
TELEGRAM_API_SERVER=
TELEGRAM_PROXY=

# --- Web & Telegram Mini App ---
WEB_APP_URL=https://your-domain.com
ADMIN_APP_URL=https://your-domain.com/admin
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Database & Cache ---
# PostgreSQL (Production recommended):
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gifthub
# Or SQLite (Development):
# DB_URL=sqlite+aiosqlite:///data/gifthub.db

REDIS_URL=redis://localhost:6379/0

# --- Support & Channels ---
SUPPORT_URL=https://t.me/gifthub_support
NEWS_CHANNEL_URL=https://t.me/gifthub_news

# --- Payment Gateways ---
# Click (Uzbekistan)
CLICK_ENABLED=true
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY

# Payme (Uzbekistan)
PAYME_ENABLED=true
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_SECRET_KEY

# AutoPayCard (Card-to-card auto-processing)
AUTOPAYCARD_ENABLED=false
AUTOPAYCARD_API_KEY=YOUR_AUTOPAYCARD_API_KEY

# --- Environment & Security ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED_DEMO_DATA=false
